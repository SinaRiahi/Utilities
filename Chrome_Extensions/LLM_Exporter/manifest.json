{
  "manifest_version": 3,
  "name": "Universal LLM Conversation Exporter",
  "version": "0.3.5",
  "description": "Select AI conversation messages, copy them as Markdown, open Markdown Studio, and optionally automate repeated follow-up prompts.",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://x.com/i/grok*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "shared/utils.js",
        "content/extractor-base.js",
        "content/chatgpt.js",
        "content/extractor-manager.js",
        "content/auto-continue.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "shared/utils.js",
        "content/extractor-base.js",
        "content/claude.js",
        "content/extractor-manager.js",
        "content/auto-continue.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "shared/utils.js",
        "content/extractor-base.js",
        "content/deepseek.js",
        "content/extractor-manager.js",
        "content/auto-continue.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "shared/utils.js",
        "content/extractor-base.js",
        "content/gemini.js",
        "content/extractor-manager.js",
        "content/auto-continue.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://grok.com/*",
        "https://x.com/i/grok*"
      ],
      "js": [
        "shared/utils.js",
        "content/extractor-base.js",
        "content/grok.js",
        "content/extractor-manager.js",
        "content/auto-continue.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
